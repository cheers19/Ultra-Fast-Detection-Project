        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "\[Theta]p"}], "]"}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "alphaw", " ", "veff",
          " ", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{"veff", " ", "\[Delta]kz", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"\[Theta]", "-", "\[Theta]p"}], "]"}]}], "-", 
        RowBox[{"2", " ", "w", " ", 
