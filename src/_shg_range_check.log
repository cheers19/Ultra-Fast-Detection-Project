  def delta_kz(dtheta_L, dw_L1, dtheta_S, dw_S):
      """Longitudinal mismatch for ╧ë1+╧ë2=╧ëSHG; dw_L2=dw_S-dw_L1."""
      dw_L2 = dw_S - dw_L1
