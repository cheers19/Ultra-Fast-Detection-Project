   "cell_type": "code",
   "id": "0731efff",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "plot_pulse_curves(hist_phys, \"Physics λ=3\")\n",
    "plot_trace_curves(hist_phys, \"Physics λ=3\")\n",
    "plot_grad_norms(hist_phys, \"Physics λ=3\")\n",
    "plot_grad_norms_linear_separate(hist_phys, \"Physics λ=3\")\n",
    "summarize_timings(hist_phys, \"Physics λ=3\")\n"
   ]
  },
